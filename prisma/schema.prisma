datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WebsiteVisit {
  id         Int     @id

  total      BigInt  @default(0)

  daily      Int     @default(0)
  dailyDate  String  @default("")

  weekly     Int     @default(0)
  weeklyKey  String  @default("")

  monthly    Int     @default(0)
  monthlyKey String  @default("")

  yearly     Int     @default(0)
  yearlyKey  String  @default("")
}

model VisitorLog {
  id        Int      @id @default(autoincrement())
  ip        String
  userAgent String
  visitDate DateTime @default(now())
}
